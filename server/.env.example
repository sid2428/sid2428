# Upstash Redis REST credentials (added automatically by the Vercel Marketplace integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Long random string. Salts visitor IP hashes, so callsigns are stable but IPs are never stored.
IP_HASH_SECRET=

# Long random string. Vercel sends it as a Bearer token to the daily cron route.
CRON_SECRET=

# Optional. Raises the GitHub API rate limit for the activity card.
GITHUB_TOKEN=
